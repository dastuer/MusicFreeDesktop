{
  "name": "musicfree-desktop",
  "version": "1.0.8",
  "private": true,
  "author": "huah",
  "description": "MusicFree 桌面版（macOS / Windows）- 参考网易云桌面端交互重构",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:main": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist-electron --watch --sourcemap",
    "dev:electron": "wait-on tcp:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .",
    "build:renderer": "vite build",
    "build:main": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --external:electron --minify --outdir=dist-electron",
    "build:main:debug": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist-electron --sourcemap",
    "debug:main": "npm run build:renderer && npm run build:main:debug && electron --inspect=9229 .",
    "build": "npm run build:renderer && npm run build:main",
    "start": "electron .",
    "dist": "npm run build && electron-builder --config electron-builder.config.js",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.config.js",
    "dist:win": "npm run build && electron-builder --win --publish=never --config.directories.output=release-win --config electron-builder.config.js",
    "dist:dir": "npm run build && electron-builder --dir --config electron-builder.config.js",
    "sparkle:rebuild": "electron-sparkle-updater rebuild",
    "release": "bash scripts/release.sh",
    "reinstall": "bash scripts/reinstall.sh",
    "reinstall:dmg": "bash scripts/reinstall.sh --with-dmg"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/he": "^1.2.3",
    "@types/object-path": "^0.11.4",
    "@types/qs": "^6.9.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "big-integer": "^1.6.52",
    "cheerio": "^1.0.0",
    "compare-versions": "^6.1.1",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.13",
    "electron-sparkle-updater": "^0.5.3",
    "eventemitter3": "^5.0.1",
    "he": "^1.2.0",
    "http-proxy-agent": "^9.1.0",
    "https-proxy-agent": "^9.1.0",
    "iconv-lite": "^0.6.3",
    "immer": "^10.1.1",
    "jotai": "^2.10.3",
    "music-metadata": "^10.5.0",
    "nanoid": "^5.0.9",
    "object-path": "^0.11.8",
    "qs": "^6.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-draggable": "^4.7.2",
    "socks-proxy-agent": "^10.1.0",
    "webdav": "^5.7.0"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.24.2": true,
    "esbuild@0.25.12": true
  }
}
